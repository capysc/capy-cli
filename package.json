{
  "name": "@capy/cli",
  "version": "0.1.0",
  "description": "Capy CLI - SecretOps for the AI age",
  "main": "dist/index.js",
  "bin": {
    "capy": "bin/capy"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/index-dev.*",
    "bin/capy"
  ],
  "scripts": {
    "build": "tsc",
    "start": "ts-node ./bin/capy.ts",
    "dev": "tsc --watch",
    "capy-dev": "bun run build && node bin/capy-dev",
    "link-dev": "ln -sf \"$(pwd)/bin/capy-dev\" /usr/local/bin/capy-dev",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.0.0",
    "commander": "^11.0.0",
    "dotenv": "^16.3.0",
    "inquirer": "^12.9.6",
    "open": "8.4.2"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "environment-variables",
    "encryption",
    "security"
  ]
}
