{
  "name": "@capy/cli",
  "version": "0.1.0",
  "description": "Capy CLI - SecretOps for the AI age",
  "main": "dist/index.js",
  "bin": {
    "capy": "bin/capy",
    "capy-dev": "bin/capy-dev"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/index-dev.*",
    "bin/capy"
  ],
  "scripts": {
    "build": "tsc",
    "start": "ts-node ./bin/capy.ts",
    "dev": "tsc --watch",
    "capy-dev": "bun run build && node bin/capy-dev",
    "prepublishOnly": "npm pkg delete bin.capy-dev",
    "test": "bash tests/run-tests.sh",
    "typecheck": "tsc --noEmit",
    "test:e2e": "bun run tests/e2e/e2e.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "dotenv": "^16.3.0",
    "inquirer": "^12.9.6",
    "open": "8.4.2",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.0.0"
  },
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "environment-variables",
    "encryption",
    "security"
  ]
}
