#!/usr/bin/env node

// capy-staging — the production CLI codepath pointed at the staging backend.
//
// Staging runs the *real* service (against the test WorkOS tenant), so this is
// real auth — it requires dist/index.js (prod), NOT index-dev.js (mock auth).
//
// Isolated home at ~/.capy-staging so it can never touch prod ~/.capy (which
// holds recovery-equivalent wrapped keys) or dev ~/.capy-dev. Both env vars are
// set only when unset, so `CAPY_API_URL=... capy-staging ...` still overrides.
if (!process.env.CAPY_GLOBAL_DIR_NAME) {
  process.env.CAPY_GLOBAL_DIR_NAME = '.capy-staging';
}
if (!process.env.CAPY_API_URL) {
  process.env.CAPY_API_URL = 'https://staging-api.capy.sc';
}
if (!process.env.CAPY_BIN_NAME) {
  process.env.CAPY_BIN_NAME = 'capy-staging';
}
// Keep must move with the backend. A device key is minted against keep's
// WebAuthn RP ID, so a door recorded in the staging database has to be
// enrolled on the staging keep origin — point a staging-backed CLI at prod
// keep and the credential is minted under the wrong RP ID, leaving a door row
// nothing can ever satisfy. Set together, they cannot drift.
if (!process.env.CAPY_KEEP_ORIGIN) {
  process.env.CAPY_KEEP_ORIGIN = 'https://staging-keep.capy.sc';
}
require('../dist/index.js');
