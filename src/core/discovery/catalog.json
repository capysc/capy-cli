{
  "version": 3,
  "about": "Discovery rules for `capy setup` (spec 3k section 7, CAP-927). Names and files only: a rule never matches a value. `env` entries are regular expressions tested against a variable name after a framework prefix in `publicPrefixes` is removed. `packages` entries ending in `/` match a whole scope or path prefix. Deployment targets (Dokploy, Vercel, AWS SSM, Cloudflare) live under `infrastructure`, not `services`; names that could belong to several providers (`DATABASE_URL`, `MONGO_URL`, `S3_BUCKET`) are left unmapped. Improving detection is an edit here plus a test in tests/core/discovery.test.ts.",
  "publicPrefixes": ["NEXT_PUBLIC_", "VITE_", "REACT_APP_", "EXPO_PUBLIC_", "NUXT_PUBLIC_", "PUBLIC_", "GATSBY_"],
  "ignore": [
    "NODE_ENV", "PORT", "HOST", "HOSTNAME", "CI", "HOME", "PATH", "PWD", "TZ", "LANG", "SHELL", "USER", "TERM", "TMPDIR",
    "DEBUG", "LOG_LEVEL", "NODE_OPTIONS", "ENV", "ENVIRONMENT", "APP_ENV", "RAILS_ENV", "RACK_ENV", "PYTHONPATH",
    "NEXT_RUNTIME", "NEXT_PHASE", "MODE", "DEV", "PROD", "SSR", "BASE_URL", "GO_ENV", "RUST_LOG", "PYTHONUNBUFFERED", "FLASK_ENV", "DJANGO_SETTINGS_MODULE"
  ],
  "infrastructureNames": ["DOKPLOY", "^VERCEL_TOKEN$", "^VERCEL_ORG_ID$", "^VERCEL_PROJECT_ID$", "^VERCEL_ENV$", "^VERCEL_URL$", "^VERCEL_REGION$", "^VERCEL_GIT_", "^VERCEL_BRANCH_URL$", "^VERCEL_PROJECT_PRODUCTION_URL$"],
  "services": [
    { "id": "stripe", "label": "Stripe", "connector": true, "env": ["^STRIPE_"], "packages": { "npm": ["stripe", "@stripe/"], "pypi": ["stripe"], "go": ["github.com/stripe/stripe-go"], "gem": ["stripe"] } },
    { "id": "workos", "label": "WorkOS", "connector": true, "env": ["^WORKOS_"], "packages": { "npm": ["@workos-inc/"], "pypi": ["workos"], "go": ["github.com/workos/workos-go"], "gem": ["workos"] } },
    { "id": "openai", "label": "OpenAI", "env": ["^OPENAI_"], "packages": { "npm": ["openai", "@ai-sdk/openai"], "pypi": ["openai"], "go": ["github.com/openai/openai-go", "github.com/sashabaranov/go-openai"], "gem": ["ruby-openai"] } },
    { "id": "anthropic", "label": "Anthropic", "env": ["^ANTHROPIC_"], "packages": { "npm": ["@anthropic-ai/", "@ai-sdk/anthropic"], "pypi": ["anthropic"], "go": ["github.com/anthropics/anthropic-sdk-go"], "gem": ["anthropic"] } },
    { "id": "google-ai", "label": "Google Gemini", "env": ["^GEMINI_", "^GOOGLE_GENERATIVE_AI_"], "packages": { "npm": ["@google/generative-ai", "@google/genai", "@ai-sdk/google"], "pypi": ["google-generativeai", "google-genai"] } },
    { "id": "resend", "label": "Resend", "env": ["^RESEND_"], "packages": { "npm": ["resend"], "pypi": ["resend"], "gem": ["resend"] } },
    { "id": "sendgrid", "label": "SendGrid", "env": ["^SENDGRID_"], "packages": { "npm": ["@sendgrid/"], "pypi": ["sendgrid"], "gem": ["sendgrid-ruby"] } },
    { "id": "postmark", "label": "Postmark", "env": ["^POSTMARK_"], "packages": { "npm": ["postmark"], "pypi": ["postmarker"], "gem": ["postmark"] } },
    { "id": "mailgun", "label": "Mailgun", "env": ["^MAILGUN_"], "packages": { "npm": ["mailgun.js", "mailgun-js"], "gem": ["mailgun-ruby"] } },
    { "id": "twilio", "label": "Twilio", "env": ["^TWILIO_"], "packages": { "npm": ["twilio"], "pypi": ["twilio"], "go": ["github.com/twilio/twilio-go"], "gem": ["twilio-ruby"] } },
    { "id": "supabase", "label": "Supabase", "env": ["^SUPABASE_"], "packages": { "npm": ["@supabase/"], "pypi": ["supabase"] } },
    { "id": "clerk", "label": "Clerk", "env": ["^CLERK_"], "packages": { "npm": ["@clerk/"], "pypi": ["clerk-backend-api"] } },
    { "id": "auth0", "label": "Auth0", "env": ["^AUTH0_"], "packages": { "npm": ["@auth0/", "auth0"], "pypi": ["auth0-python"] } },
    { "id": "firebase", "label": "Firebase", "env": ["^FIREBASE_"], "packages": { "npm": ["firebase", "firebase-admin"], "pypi": ["firebase-admin"] } },
    { "id": "sentry", "label": "Sentry", "env": ["^SENTRY_"], "packages": { "npm": ["@sentry/"], "pypi": ["sentry-sdk"], "go": ["github.com/getsentry/sentry-go"], "gem": ["sentry-ruby"] } },
    { "id": "posthog", "label": "PostHog", "env": ["^POSTHOG_"], "packages": { "npm": ["posthog-js", "posthog-node"], "pypi": ["posthog"], "gem": ["posthog-ruby"] } },
    { "id": "segment", "label": "Segment", "env": ["^SEGMENT_"], "packages": { "npm": ["@segment/"], "pypi": ["segment-analytics-python"] } },
    { "id": "datadog", "label": "Datadog", "env": ["^DATADOG_", "^DD_(API_KEY|APP_KEY|SITE|SERVICE|ENV|VERSION|AGENT_HOST|TRACE_.*|LOGS_.*)$"], "packages": { "npm": ["dd-trace", "@datadog/"], "pypi": ["ddtrace", "datadog"] } },
    { "id": "algolia", "label": "Algolia", "env": ["^ALGOLIA_"], "packages": { "npm": ["algoliasearch"], "pypi": ["algoliasearch"] } },
    { "id": "pusher", "label": "Pusher", "env": ["^PUSHER_"], "packages": { "npm": ["pusher", "pusher-js"], "pypi": ["pusher"] } },
    { "id": "upstash", "label": "Upstash", "env": ["^UPSTASH_"], "packages": { "npm": ["@upstash/"], "pypi": ["upstash-redis"] } },
    { "id": "neon", "label": "Neon", "env": ["^NEON_"], "packages": { "npm": ["@neondatabase/"] } },
    { "id": "planetscale", "label": "PlanetScale", "env": ["^PLANETSCALE_"], "packages": { "npm": ["@planetscale/"] } },
    { "id": "mongodb-atlas", "label": "MongoDB", "env": ["^MONGODB_ATLAS_"], "packages": { "npm": ["mongodb", "mongoose"], "pypi": ["pymongo"] } },
    { "id": "pinecone", "label": "Pinecone", "env": ["^PINECONE_"], "packages": { "npm": ["@pinecone-database/"], "pypi": ["pinecone", "pinecone-client"] } },
    { "id": "replicate", "label": "Replicate", "env": ["^REPLICATE_"], "packages": { "npm": ["replicate"], "pypi": ["replicate"] } },
    { "id": "cloudinary", "label": "Cloudinary", "env": ["^CLOUDINARY_"], "packages": { "npm": ["cloudinary", "next-cloudinary"], "pypi": ["cloudinary"] } },
    { "id": "mapbox", "label": "Mapbox", "env": ["^MAPBOX_"], "packages": { "npm": ["mapbox-gl", "@mapbox/"] } },
    { "id": "github", "label": "GitHub", "env": ["^GITHUB_CLIENT_ID$", "^GITHUB_CLIENT_SECRET$", "^GITHUB_APP_", "^GITHUB_TOKEN$", "^GITHUB_PAT$"], "packages": { "npm": ["@octokit/"], "pypi": ["PyGithub"] } },
    { "id": "google", "label": "Google", "env": ["^GOOGLE_CLIENT_ID$", "^GOOGLE_CLIENT_SECRET$", "^GOOGLE_APPLICATION_CREDENTIALS$", "^GOOGLE_MAPS_"], "packages": { "npm": ["googleapis", "google-auth-library"], "pypi": ["google-auth", "google-api-python-client"] } },
    { "id": "slack", "label": "Slack", "env": ["^SLACK_"], "packages": { "npm": ["@slack/"], "pypi": ["slack-sdk", "slack_sdk"] } },
    { "id": "discord", "label": "Discord", "env": ["^DISCORD_"], "packages": { "npm": ["discord.js"], "pypi": ["discord.py"] } },
    { "id": "linear", "label": "Linear", "env": ["^LINEAR_"], "packages": { "npm": ["@linear/"] } },
    { "id": "lemonsqueezy", "label": "Lemon Squeezy", "env": ["^LEMONSQUEEZY_", "^LEMON_SQUEEZY_"], "packages": { "npm": ["@lemonsqueezy/"] } },
    { "id": "paddle", "label": "Paddle", "env": ["^PADDLE_"], "packages": { "npm": ["@paddle/"] } },
    { "id": "plaid", "label": "Plaid", "env": ["^PLAID_"], "packages": { "npm": ["plaid"], "pypi": ["plaid-python"] } },
    { "id": "shopify", "label": "Shopify", "env": ["^SHOPIFY_"], "packages": { "npm": ["@shopify/"], "pypi": ["ShopifyAPI"] } },
    { "id": "hubspot", "label": "HubSpot", "env": ["^HUBSPOT_"], "packages": { "npm": ["@hubspot/"], "pypi": ["hubspot-api-client"] } },
    { "id": "launchdarkly", "label": "LaunchDarkly", "env": ["^LAUNCHDARKLY_", "^LD_SDK_KEY$"], "packages": { "npm": ["launchdarkly-node-server-sdk", "@launchdarkly/"], "pypi": ["launchdarkly-server-sdk"] } },
    { "id": "pagerduty", "label": "PagerDuty", "env": ["^PAGERDUTY_"], "packages": { "npm": ["@pagerduty/"], "pypi": ["pdpyras", "pagerduty"] } },
    { "id": "opsgenie", "label": "Opsgenie", "env": ["^OPSGENIE_"], "packages": { "npm": ["opsgenie-sdk"], "pypi": ["opsgenie-sdk"] } },
    { "id": "statuspage", "label": "Atlassian Statuspage", "env": ["^STATUSPAGE_"] },
    { "id": "betterstack", "label": "Better Stack", "env": ["^LOGTAIL_", "^BETTERSTACK_", "^BETTER_STACK_"], "packages": { "npm": ["@logtail/"], "pypi": ["logtail-python"] } },
    { "id": "shippo", "label": "Shippo", "env": ["^SHIPPO_"], "packages": { "npm": ["shippo"], "pypi": ["shippo"] } },
    { "id": "taxjar", "label": "TaxJar", "env": ["^TAXJAR_"], "packages": { "npm": ["taxjar"], "pypi": ["taxjar"] } },
    { "id": "voyage", "label": "Voyage AI", "env": ["^VOYAGE_"], "packages": { "npm": ["voyageai"], "pypi": ["voyageai"] } },
    { "id": "aws", "label": "AWS", "env": ["^AWS_ACCESS_KEY_ID$", "^AWS_SECRET_ACCESS_KEY$", "^AWS_SESSION_TOKEN$", "^AWS_REGION$", "^AWS_DEFAULT_REGION$", "^AWS_PROFILE$"], "packages": { "npm": ["@aws-sdk/", "aws-sdk"], "pypi": ["boto3", "botocore"], "go": ["github.com/aws/aws-sdk-go"], "gem": ["aws-sdk"] } },
    { "id": "cloudflare", "label": "Cloudflare", "env": ["^CLOUDFLARE_", "^CF_API_TOKEN$", "^CF_ACCOUNT_ID$", "^TURNSTILE_"], "packages": { "npm": ["cloudflare", "@marsidev/react-turnstile"], "pypi": ["cloudflare"] } },
    { "id": "vercel", "label": "Vercel", "env": ["^BLOB_READ_WRITE_TOKEN$", "^KV_REST_API_", "^EDGE_CONFIG$"], "packages": { "npm": ["@vercel/blob", "@vercel/kv", "@vercel/postgres", "@vercel/edge-config"] } }
  ],
  "infrastructure": {
    "vercel": { "label": "Vercel", "files": ["vercel.json", ".vercel/project.json"], "systemNames": ["^VERCEL_ENV$", "^VERCEL_URL$", "^VERCEL_REGION$", "^VERCEL_GIT_", "^VERCEL_BRANCH_URL$", "^VERCEL_PROJECT_PRODUCTION_URL$"] },
    "dokploy": { "label": "Dokploy", "composeMarker": "dokploy" },
    "cloudflare": { "label": "Cloudflare", "files": ["wrangler.toml", "wrangler.json", "wrangler.jsonc"] },
    "aws-ssm": { "label": "AWS SSM Parameter Store", "textMarkers": ["aws_ssm_parameter", "${ssm:", "ssm:GetParameter", "aws ssm get-parameter", "aws ssm put-parameter", "@aws-sdk/client-ssm", "client('ssm')", "client(\"ssm\")"] }
  }
}
